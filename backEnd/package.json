{
  "name": "stock-system-api",
  "version": "1.0.0",
  "description": "Stock system API built with Express and TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "start": "node --use-system-ca dist/server.js",
    "dev": "node --use-system-ca -r ts-node/register src/server.ts",
    "build": "tsc",
    "migrate": "node -r ts-node/register src/database/migrate.ts up",
    "migrate:status": "node -r ts-node/register src/database/migrate.ts status",
    "migrate:baseline": "node -r ts-node/register src/database/migrate.ts baseline",
    "test": "node -r ts-node/register --test tests/*.test.ts"
  },
  "keywords": [
    "stock",
    "api",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^1.2.12",
    "@langchain/openrouter": "^0.4.13",
    "@types/multer": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.3.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}
